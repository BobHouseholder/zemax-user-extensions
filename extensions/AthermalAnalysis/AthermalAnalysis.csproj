<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\ZemaxPaths.props" Condition="Exists('..\..\ZemaxPaths.props')" />
  <Import Project="..\..\repo\ZemaxPaths.props" Condition="!Exists('..\..\ZemaxPaths.props')" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AthermalScan</RootNamespace>
    <AssemblyName>AthermalAnalysis</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      AthermalScan's Program.cs is linked in below and has its own Main. Both entry
      points therefore exist in this assembly, so the startup object must be named
      explicitly; the extension's Main is simply never called here.
    -->
    <StartupObject>AthermalScan.AnalysisProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Linked, not copied. The thermal model in Program.cs is validated to all 14
      displayed figures against Make Thermal's own pickup solves, and a second copy
      of it would be a second thing to keep in step - which is the failure mode this
      repo has already paid for more than once.
    -->
    <Compile Include="..\AthermalScan\Program.cs" />
    <Compile Include="..\AthermalScan\Reports.cs" />
    <Compile Include="..\AthermalScan\ScanSettingsDialog.cs" />
    <Compile Include="..\Shared\ZemaxLocator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="ZOSAPI">
      <HintPath>$(ZEMAX_ROOT)\ZOSAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZOSAPI_Interfaces">
      <HintPath>$(ZEMAX_ROOT)\ZOSAPI_Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZOSAPI_NetHelper">
      <HintPath>$(ZEMAX_ROOT)\ZOSAPI_NetHelper.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
